# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional bilingual Communication Coach. Keep disabled until migration 033 and a supervised voice test pass.
# Server-only: never use NEXT_PUBLIC_ for an AI key. Set project billing limits with your provider.
VOICE_COACH_ENABLED=false
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_COACH_MODEL=gpt-4.1-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
VOICE_COACH_DAILY_REQUESTS=20
VOICE_COACH_PLATFORM_DAILY_REQUESTS=200
